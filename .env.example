# URL du back-end (utilisée partout — services, composants, axios)
VITE_API_URL=http://localhost:3000

# ⚠️ Toute valeur préfixée par VITE_ est INCLUSE DANS LE BUNDLE JS, donc visible
# par n'importe quel visiteur : n'y mettez jamais de secret. Le formulaire de
# contact passe par POST /api/contact ; son webhook Discord se configure côté
# back (SUPPORT_DISCORD_WEBHOOK_URL).
