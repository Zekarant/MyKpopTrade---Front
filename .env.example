# URL du back-end (utilisée partout — services, composants, axios)
VITE_API_URL=http://localhost:3000

# Webhook Discord pour le formulaire de contact.
# ⚠️ ATTENTION : toute valeur préfixée par VITE_ est INCLUSE DANS LE BUNDLE JS et donc
# visible par n'importe quel visiteur via les DevTools. Cette URL doit donc être
# considérée comme publique. À terme, déplacer le call Discord vers un endpoint back
# pour que le secret reste serveur-side.
VITE_DISCORD_WEBHOOK_URL=
